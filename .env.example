# Postgres (Neon) — copia la cadena "pooled" desde el dashboard de Neon
DATABASE_URL="postgresql://USUARIO:CONTRASEÑA@HOST-pooler.REGION.aws.neon.tech/NOMBRE_BD?sslmode=require"

# Secreto para firmar los JWT. Genera uno con:  openssl rand -base64 32
JWT_SECRET=""

# Se usa UNA sola vez, al correr `npm run db:seed`, para crear al admin.
# Bórralo de tu .env después de sembrar. NUNCA lo subas a Git.
ADMIN_EMAIL="mesadecontrol@petrowax.com"
ADMIN_PASSWORD=""

# Clave para cifrar los secretos 2FA en la base. Genera una con:
#   openssl rand -base64 32
# IMPORTANTE: fíjala una vez y NO la cambies. Si la cambias, todos los
# usuarios tendrán que reconfigurar su app autenticadora.
TWOFA_ENC_KEY=""
